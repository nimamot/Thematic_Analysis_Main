# =============================================================================
# Pipeline configuration — single source of truth for toggles and study inputs.
#
# Priority (highest → lowest):
#   1. Shell export before sbatch  (one-off:  GT_CODEBOOK_REVIEW=0 sbatch run.sh)
#   2. This file                 (agents/scripts/pipeline_config.env)
#   3. .env.supabase             (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY only)
#   4. Code defaults
#
# Secrets never go here — use agents/scripts/.env.supabase (gitignored).
# Effective values are printed at job start and saved under agents/outputs/logs/.
# =============================================================================

# --- Study inputs ---
export RESEARCH_QUESTION="What thematic patterns emerge across these reviews?"
# Path relative to repo root, or absolute.
export GT_DATA_CSV="data/train.csv"
export PIPELINE_SLUG="default"

# --- Launcher (run.sh) ---
# sgl = SGLang in Apptainer (default); lm = LM Studio dual-SIF path
export GT_LAUNCHER="sgl"

# --- Human-in-the-loop codebook review (after high-level labels) ---
export GT_CODEBOOK_REVIEW=1
export GT_CODEBOOK_REVIEW_MODE=manual
# local = viewer-data/ ; supabase = shared DB ; auto = supabase if creds else local
export GT_CODEBOOK_REVIEW_BACKEND=local
export GT_CODEBOOK_REVIEW_TIMEOUT_SEC=86400
export GT_CODEBOOK_REVIEW_POLL_INTERVAL_SEC=30
# Auto-open viewer_launcher while waiting (local runs only; ignored on Slurm)
export GT_VIEWER_AUTO_LAUNCH=1

# --- Viewer export & Supabase upload ---
export GT_VIEWER_EXPORT=1
export UPLOAD_TO_SUPABASE=0

# --- Qualitative enrichment ---
export GT_QUALITATIVE_ENRICHMENT=1
export GT_ENRICH_WORKERS=4

# --- Parallelism & high-level strategy ---
export GT_OPEN_CODING_WORKERS=8
export GT_HIGH_LEVEL_STRATEGY=nsampling
export GT_HL_N_SAMPLES=5
export GT_HL_SAMPLE_SIZE=15
export GT_HIGH_LEVEL_WORKERS=8
export GT_HIERARCHY_WORKERS=8
export GT_HIERARCHY_REFINE=1
export GT_USE_SKILLS=1

# --- SGLang / inference (launch scripts may override at runtime) ---
# export GT_SGLANG_CONTEXT_LENGTH=8192
# export GT_OPENAI_BASE=http://127.0.0.1:8000/v1
# export GT_LLM_MODEL=llm
# export GT_EMBED_BACKEND=sentence_transformers
